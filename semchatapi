### Kernel Initialization

**File**: `src/services/chat_service.py`

```python
async def initialize_kernel(self) -> Kernel:
    """Initialize Semantic Kernel with Azure OpenAI"""
    kernel = Kernel()
    
    # Add Azure OpenAI chat completion service
    chat_service = AzureChatCompletion(
        service_id="azure_openai",
        deployment_name=settings.AZURE_OPENAI_DEPLOYMENT_NAME,  # "TP_GINA"
        endpoint=settings.AZURE_OPENAI_ENDPOINT,
        api_key=settings.AZURE_OPENAI_API_KEY,
        api_version="2024-02-15-preview"
    )
    
    kernel.add_service(chat_service)
    
    # Register function plugins (7 tools)
    # TODO: Implement each plugin class
    kernel.add_plugin(DatabasePlugin(), "Database")
    kernel.add_plugin(AzureDevOpsPlugin(), "AzureDevOps")
    kernel.add_plugin(FinOpsPlugin(), "FinOps")
    kernel.add_plugin(KnowledgeBasePlugin(), "KnowledgeBase")
    kernel.add_plugin(ProjectLifecyclePlugin(), "ProjectLifecycle")
    kernel.add_plugin(SecurityMonitoringPlugin(), "SecurityMonitoring")
    kernel.add_plugin(SiteNavigationPlugin(), "SiteNavigation")
    
    return kernel
```

### Chat History Management

```python
async def _build_chat_history(
    self, 
    conversation_id: UUID, 
    limit: int = 10
) -> ChatHistory:
    """Load conversation history from database"""
    
    history = ChatHistory()
    history.add_system_message(SYSTEM_PROMPT)
    
    # Load last N messages
    messages = await MessageService.get_messages(
        self.db, 
        conversation_id, 
        limit=limit
    )
    
    for msg in messages:
        if msg.Role == "user":
            history.add_user_message(msg.Content)
        elif msg.Role == "assistant":
            history.add_assistant_message(msg.Content)
    
    return history
```

### Function Calling Execution

```python
async def _invoke_ai(
    self, 
    kernel: Kernel, 
    history: ChatHistory, 
    user_query: str
) -> AIResponse:
    """Execute AI query with function calling enabled"""
    
    # Add user query to history
    history.add_user_message(user_query)
    
    # Configure function calling behavior
    settings = AzureChatPromptExecutionSettings(
        function_choice_behavior=FunctionChoiceBehavior.Auto()
    )
    
    # Get AI service from kernel
    chat_service = kernel.get_service(type=ChatCompletionClientBase)
    
    # Execute with automatic function calling
    response = await chat_service.get_chat_message_content(
        chat_history=history,
        settings=settings,
        kernel=kernel
    )
    
    return AIResponse(
        content=str(response),
        tool_name=getattr(response, "function_name", None),
        model_used="gpt-4"
    )
```

### How Function Calling Works

**Example Flow**:

1. **User Query**: "Show me all work items created last month"

2. **AI Analysis**: GPT-4 recognizes this requires `AzureDevOps.GetWorkItems()`

3. **Function Signature** (from plugin):
```python
@kernel_function(
    name="GetWorkItems",
    description="Retrieves work items from Azure DevOps based on date range"
)
async def get_work_items(
    self,
    project: str,
    start_date: str,
    end_date: str
) -> str:
    # Implementation
```

4. **AI Decides to Call**:
```json
{
  "function": "AzureDevOps.GetWorkItems",
  "arguments": {
    "project": "MainProject",
    "start_date": "2025-12-01",
    "end_date": "2025-12-31"
  }
}
```

5. **Semantic Kernel Executes**: Python function runs, queries Azure DevOps API

6. **Results Returned**: JSON data with work items

7. **AI Formats Response**: "Here are the work items from December 2025:..."

