Implementation:

Backend: WebSocket endpoint

from fastapi import WebSocket

@app.websocket('/ws/analysis/{project_id}')
async def analysis_progress(websocket: WebSocket, project_id: int):
    await websocket.accept()
    
    while True:
        # Check progress from database
        summary = db.query(AnalysisSummary).get(project_id)
        
        progress = {
            'status': summary.analysis_status,
            'progress_pct': summary.progress_percentage,
            'current_step': summary.current_step
        }
        
        await websocket.send_json(progress)
        
        if summary.analysis_status in ['completed', 'failed']:
            break
        
        await asyncio.sleep(2)  # Update every 2 seconds
    
    await websocket.close()
Background Task: Update progress

async def analyze_project(project_id):
    total_steps = 10
    
    # Step 1: Parse CSV
    update_progress(project_id, 1, total_steps, 'Parsing CSV')
    parse_csv()
    
    # Step 2: Analyze age
    update_progress(project_id, 2, total_steps, 'Analyzing age')
    analyze_age_distribution()
    
