_parse_csv_file() - Bulk Data Loading
async def _parse_csv_file(self, csv_file: ScriptResult, project_id: int) -> int:
    blob_content = await self._download_blob(csv_file.blob_url)
    csv_text = blob_content.decode('utf-8-sig')  # Handle BOM
    reader = csv.DictReader(io.StringIO(csv_text))
    
    batch = []
    batch_size = 1000
    
    for row in reader:
        metadata = FileMetadata(...)
        batch.append(metadata)
        
        if len(batch) >= batch_size:
            self.db.bulk_save_objects(batch)
            self.db.commit()
            batch = []
Performance Optimization:

# BAD: One-by-one inserts
for row in reader:
    metadata = FileMetadata(...)
    db.add(metadata)
    db.commit()  # 1000 commits for 1000 rows = SLOW!

# GOOD: Batch inserts
batch = []
for row in reader:
    batch.append(FileMetadata(...))
    if len(batch) >= 1000:
        db.bulk_save_objects(batch)
        db.commit()  # 1 commit for 1000 rows = FAST!

# Benchmark:
# 100,000 rows:
# One-by-one: 300 seconds
# Batch (1000): 15 seconds
# 20x faster!
Why decode('utf-8-sig')?

# CSV files from Excel often have BOM (Byte Order Mark):
# File bytes: EF BB BF 53 65 72 76 65 72 ...
#             └──BOM──┘ └─"Server"─┘

# Without 'utf-8-sig':
text = blob_content.decode('utf-8')
# text = "\ufeffServerName,Drive,..."  # ← BOM character in string!

# With 'utf-8-sig':
text = blob_content.decode('utf-8-sig')
